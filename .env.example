# .env — local secrets for price_watch.py
# ------------------------------------------------------------------
# 1. Copy this file to ".env" (if it isn't already named that).
# 2. Fill in real values below.
# 3. NEVER commit the filled-in .env to git — add it to .gitignore.
#    This file is only for running the script locally.
#
# GMAIL_APP_PASSWORD must be a Google "App Password", not your normal
# Gmail password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account)

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
TO_ADDRESS=
